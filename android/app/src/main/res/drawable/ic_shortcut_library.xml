<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut icon: white symbol on the app's orange circle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/icon_background" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_library_glyph" android:gravity="center" android:width="26dp" android:height="26dp" />
</layer-list>
